# 仅用于安全参考的模板。生产运行时密钥应写入 Cloudflare Wrangler Secrets。
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
SESSION_ENCRYPTION_KEY=replace-with-a-long-random-value
OAUTH_STATE_ENCRYPTION_KEY=replace-with-a-long-random-value
GITHUB_OWNER=HKLHaoBin
GITHUB_REPO=open-motion
FEED_LIMIT=30
FEED_TTL_SECONDS=900
SESSION_TTL_SECONDS=28800
OAUTH_STATE_TTL_SECONDS=600
GITHUB_API_VERSION=2022-11-28
ALLOWED_ORIGIN=http://localhost:4173
PUBLIC_SITE_URL=http://localhost:4173
OAUTH_CALLBACK_URL=http://127.0.0.1:8787/auth/callback
COOKIE_SECURE=false
OPEN_MOTION_SESSIONS_KV_ID=replace-with-production-session-kv-id
OPEN_MOTION_SESSIONS_PREVIEW_KV_ID=replace-with-preview-session-kv-id
OPEN_MOTION_FEED_KV_ID=replace-with-production-feed-kv-id
OPEN_MOTION_FEED_PREVIEW_KV_ID=replace-with-preview-feed-kv-id
# CI 专用：真实值应写入 GitHub Actions Secrets，不能写在这里。
CLOUDFLARE_API_TOKEN=replace-me
CLOUDFLARE_ACCOUNT_ID=replace-me

# 完整中文部署流程：worker/.env 和 docs/DEPLOYMENT.md
